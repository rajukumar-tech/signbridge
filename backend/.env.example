# PostgreSQL (docker-compose). Leave unset to fall back to SQLite (./signbridge.db)
DATABASE_URL=postgresql+psycopg://signbridge:signbridge@localhost:5432/signbridge
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated emails that get the reviewer role on registration (bootstrap)
REVIEWER_EMAILS=
SEED_ON_STARTUP=true
